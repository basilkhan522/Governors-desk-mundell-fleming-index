<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>The Governor's Desk | Mundell-Fleming Simulator</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=Playfair+Display:wght@600;800&display=swap" rel="stylesheet">
<style>
:root{
  --ink:#061c19; --ink2:#0a2a25; --ink3:#103a33; --paper:#e3eae1; --paper2:#d3ddd1;
  --gold:#d9b45a; --gold2:#f0d78f; --tx:#e8efe6; --mu:#8fa9a0; --ln:rgba(217,180,90,.28);
  --is:#c8321f; --lm:#1747b5; --bp:#9a6b00; --pg:#6b3fb0; --ok:#6fd39a; --bad:#ff6b57; --fg:#0a2622;
  --serif:"Playfair Display","Didot","Bodoni 72",Georgia,serif;
  --sans:"IBM Plex Sans",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--ink);color:var(--tx);font:15px/1.55 var(--sans);min-height:100vh;overflow-x:hidden;font-variant-numeric:tabular-nums}
#bg{position:fixed;inset:0;z-index:-1;background:
  radial-gradient(1200px 700px at 50% -20%,rgba(31,120,100,.35),transparent 65%),
  repeating-radial-gradient(circle at 12% 110%,transparent 0 11px,rgba(217,180,90,.06) 11px 12px),
  repeating-radial-gradient(circle at 92% -10%,transparent 0 13px,rgba(217,180,90,.05) 13px 14px),
  var(--ink)}
button{font:inherit;cursor:pointer}
button:focus-visible,input:focus-visible,select:focus-visible{outline:2px solid var(--gold);outline-offset:2px}
h1,h2,h3{font-family:var(--serif);margin:0;font-weight:800;letter-spacing:.01em}
.wrap{max-width:1280px;margin:0 auto;padding:0 20px}
.screen[hidden]{display:none}

/* top brand + ticker */
.brandbar{display:flex;align-items:center;gap:14px;padding:14px 0}
.seal{width:34px;height:34px;border-radius:50%;border:2px solid var(--gold);display:grid;place-items:center;font-family:var(--serif);font-weight:800;color:var(--gold);font-size:16px;box-shadow:inset 0 0 0 3px var(--ink),inset 0 0 0 4px var(--ln)}
.brandbar b{font-family:var(--serif);font-size:18px;letter-spacing:.02em}
.brandbar span{color:var(--mu);font-size:13px}
.brandbar .sp{flex:1}
.ghost{background:transparent;color:var(--tx);border:1px solid var(--ln);border-radius:4px;padding:7px 13px;font-size:13px}
.ghost:hover{border-color:var(--gold);color:var(--gold2)}
.ticker{overflow:hidden;border-block:1px solid var(--ln);background:rgba(0,0,0,.25);white-space:nowrap}
.tk{display:inline-block;padding:7px 0;animation:tick 70s linear infinite;color:var(--gold2);font-size:12.5px}
.tk i{font-style:normal;margin:0 26px;color:var(--mu)}
@keyframes tick{to{transform:translateX(-50%)}}

/* home */
.hero{padding:54px 0 26px;text-align:left;max-width:860px}
.serial{font-size:12.5px;color:var(--gold);letter-spacing:.06em;border:1px solid var(--ln);display:inline-block;padding:3px 10px;border-radius:2px}
.hero h1{font-size:clamp(46px,8.4vw,104px);line-height:.95;margin:18px 0 18px;background:linear-gradient(180deg,#fff3cf,var(--gold) 55%,#9b7a2c);-webkit-background-clip:text;background-clip:text;color:transparent;text-shadow:0 0 1px rgba(0,0,0,.2)}
.lead{font-size:18px;color:#c9d8cf;max-width:62ch}
.namebox{margin-top:22px;display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.namebox label{color:var(--mu);font-size:14px}
.namebox input{background:var(--ink2);border:1px solid var(--ln);border-radius:4px;color:var(--tx);padding:9px 12px;font:inherit;min-width:230px}
.modes{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin:26px 0}
.mode{position:relative;text-align:left;background:linear-gradient(160deg,var(--ink3),var(--ink2));border:1px solid var(--ln);border-radius:4px;padding:22px 22px 20px;color:var(--tx);transition:transform .15s,border-color .15s}
.mode:hover{transform:translateY(-3px);border-color:var(--gold)}
.mode h3{font-size:24px;margin-bottom:6px}
.mode p{margin:0 0 14px;color:#b9cbc1;font-size:14.5px}
.mode .tag{font-size:13px;color:var(--gold2)}
.mode.fx{background:linear-gradient(160deg,#33214f,#1a1230)}
.mode.sb{background:linear-gradient(160deg,#2a3b22,#16240f)}
.howto{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin:10px 0 24px}
.howto div{border-left:2px solid var(--gold);padding:2px 0 2px 14px;color:#c4d3ca;font-size:14px}
.howto b{display:block;color:var(--tx);font-family:var(--serif);font-size:17px;margin-bottom:2px}
.tri{display:flex;gap:26px;align-items:center;flex-wrap:wrap;border:1px solid var(--ln);border-radius:4px;padding:18px 22px;margin-bottom:60px;background:rgba(0,0,0,.2)}
.tri svg{flex:0 0 auto}
.tri p{margin:0;flex:1;min-width:240px;color:#c4d3ca}
.tri b{color:var(--gold2)}

/* game */
.topbar{display:flex;gap:10px;align-items:center;flex-wrap:wrap;padding:12px 0}
.pill{border:1px solid var(--ln);border-radius:3px;padding:5px 12px;font-size:13.5px;background:rgba(0,0,0,.25)}
.pill b{font-size:16px;color:var(--gold2);margin-left:6px}
.pill.reg{background:var(--gold);color:var(--ink);border-color:var(--gold);font-weight:600}
.pill.reg.fixed{background:#b9a0ee;border-color:#b9a0ee}
.topbar .sp{flex:1}
.sand{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.sand select{background:var(--ink2);color:var(--tx);border:1px solid var(--ln);border-radius:4px;padding:6px 8px;font:inherit;font-size:13px;max-width:230px}
.seg{display:inline-flex;border:1px solid var(--ln);border-radius:4px;overflow:hidden}
.seg button{background:transparent;color:var(--tx);border:0;padding:6px 12px;font-size:13px}
.seg button.on{background:var(--gold);color:var(--ink);font-weight:600}
.grid{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(330px,1fr);gap:20px;padding-bottom:50px}
.news{border:1px solid var(--gold);border-radius:4px;padding:16px 20px;background:linear-gradient(100deg,rgba(217,180,90,.16),rgba(217,180,90,.04));margin-bottom:18px}
.news.hit{animation:flash .9s ease-out}
@keyframes flash{0%{box-shadow:0 0 0 0 rgba(255,107,87,.9);background:rgba(255,107,87,.3)}100%{box-shadow:0 0 0 18px rgba(255,107,87,0)}}
.news .t{font-size:13px;color:var(--gold2);font-weight:600}
.news h2{font-size:clamp(22px,3vw,30px);line-height:1.15;margin:4px 0 6px}
.news p{margin:0;color:#cfdcd3}
.news .fxn{margin-top:8px;font-size:13.5px;color:#a9c1b6;border-top:1px dashed var(--ln);padding-top:8px}
.charts{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.cc{background:var(--paper);color:var(--fg);border-radius:3px;padding:12px 12px 10px;outline:1px solid rgba(10,38,34,.45);outline-offset:-5px;box-shadow:0 14px 40px rgba(0,0,0,.35)}
.cc h3{font-size:15.5px;margin:2px 6px 0;color:#0a2622}
.cc small{display:block;margin:0 6px 4px;color:#3f5a50;font-size:12.5px}
canvas{width:100%;aspect-ratio:1/1.0;display:block}
.leg{display:flex;gap:12px;flex-wrap:wrap;font-size:12px;margin:2px 6px 2px;color:#2d4a40}
.leg i{display:inline-block;width:18px;height:3px;vertical-align:middle;margin-right:5px;border-radius:2px}
.leg i.gh{background:repeating-linear-gradient(90deg,#456 0 4px,transparent 4px 8px)!important;height:2px}
.card{background:linear-gradient(170deg,var(--ink3),var(--ink2));border:1px solid var(--ln);border-radius:4px;padding:16px 18px;margin-bottom:16px}
.card h3{font-size:17px;margin-bottom:10px;display:flex;justify-content:space-between;align-items:baseline;gap:8px}
.card h3 em{font:400 12.5px var(--sans);color:var(--mu)}
.drow{display:grid;grid-template-columns:1fr auto;gap:2px 10px;margin-bottom:10px;font-size:13.5px}
.dl{color:var(--mu)}
.dv{text-align:right;color:var(--tx)}
.dv b{font-size:16px;color:var(--gold2)}
.gauge{grid-column:1/-1;height:7px;background:rgba(255,255,255,.1);border-radius:4px;position:relative}
.gauge .zone{position:absolute;top:0;bottom:0;background:rgba(111,211,154,.4);border-radius:3px}
.gauge .mk{position:absolute;top:-4px;width:5px;height:15px;border-radius:2px;transform:translateX(-50%);box-shadow:0 0 8px rgba(255,255,255,.6);transition:left .35s}
.proj{display:flex;justify-content:space-between;align-items:center;border-top:1px dashed var(--ln);padding-top:10px;font-size:13.5px}
.proj b{font-size:22px;font-family:var(--serif);color:var(--gold2)}
.warn{color:var(--bad);font-weight:600}
.lev{display:grid;grid-template-columns:34px 1fr;gap:2px 10px;padding:9px 0;border-top:1px solid rgba(217,180,90,.15);position:relative}
.lev:first-of-type{border-top:0}
.lev .li{grid-row:1/3;font-size:22px;align-self:center;text-align:center}
.lev .lt b{font-weight:600}
.lev .lt small{color:var(--mu);margin-left:8px;font-size:12.5px}
.lev .lb{display:flex;gap:6px}
.lev .lb button{flex:1;background:rgba(255,255,255,.05);border:1px solid var(--ln);color:var(--tx);border-radius:3px;padding:6px 4px;font-size:12.5px}
.lev .lb button:hover:not(:disabled){border-color:var(--gold);background:rgba(217,180,90,.14)}
.lev button:disabled{opacity:.35;cursor:not-allowed}
.cost{position:absolute;right:0;top:9px;font-size:11.5px;color:var(--gold);}
.lev.off .lt b{opacity:.5}
.adv{min-height:130px;font-size:14px;color:#d3e0d7}
.adv b{color:var(--gold2)}
.chips{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}
.chip{border:1px solid var(--ln);border-radius:3px;padding:3px 9px;font-size:12.5px;background:rgba(0,0,0,.25)}
.chip.up{color:var(--ok)} .chip.dn{color:var(--bad)}
.actions{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.pcs{display:flex;gap:6px;align-items:center;font-size:13px;color:var(--mu)}
.pip{width:15px;height:15px;border-radius:50%;border:2px solid var(--gold);background:transparent}
.pip.on{background:var(--gold)}
.go{background:var(--gold);color:var(--ink);border:0;border-radius:4px;padding:11px 20px;font-weight:600;font-size:15px;margin-left:auto}
.go:hover{background:var(--gold2)}
.go.sec{background:transparent;color:var(--tx);border:1px solid var(--ln);font-weight:500;margin-left:0;padding:9px 14px;font-size:13.5px}

/* overlay */
#overlay{position:fixed;inset:0;background:rgba(2,10,9,.8);display:grid;place-items:center;z-index:50;padding:16px;backdrop-filter:blur(4px)}
#overlay[hidden]{display:none}
.box{background:var(--paper);color:var(--fg);max-width:560px;width:100%;border-radius:3px;padding:26px 28px;outline:2px solid var(--fg);outline-offset:-8px;box-shadow:0 30px 80px rgba(0,0,0,.6);animation:pop .35s ease-out}
@keyframes pop{from{transform:scale(.94);opacity:0}}
.box h2{font-size:28px;margin-bottom:10px}
.box .rg{display:grid;grid-template-columns:1fr auto;gap:6px 14px;margin:12px 0;font-size:15px}
.box .rg span:nth-child(even){text-align:right;font-weight:600}
.box .big{font:800 44px var(--serif);text-align:right;border-top:2px solid var(--fg);margin-top:6px;padding-top:4px}
.box.crisis{background:#f3d6cf;outline-color:#9c1c0b}
.box.crisis h2{color:#9c1c0b}
.box .go{margin:10px 0 0;background:var(--fg);color:var(--paper);display:block;width:100%}
.box .go:hover{background:#17463d}
.shake{animation:shake .5s}
@keyframes shake{20%{transform:translateX(-8px)}40%{transform:translateX(8px)}60%{transform:translateX(-5px)}80%{transform:translateX(5px)}}

/* end */
.endh{padding:46px 0 10px}
.rank{font:800 clamp(34px,6vw,64px)/1 var(--serif);color:var(--gold2);margin:6px 0}
.endgrid{display:grid;grid-template-columns:1.2fr 1fr;gap:20px;margin:18px 0 60px}
.bars{display:flex;align-items:flex-end;gap:10px;height:180px;margin-top:8px}
.bars div{flex:1;background:linear-gradient(var(--gold2),#8b6c22);border-radius:2px 2px 0 0;position:relative;min-height:3px}
.bars div.cr{background:linear-gradient(#ff8a78,#8a1f10)}
.bars span{position:absolute;top:-19px;left:0;right:0;text-align:center;font-size:12px;color:var(--tx)}
.bars + .bl{display:flex;gap:10px;font-size:12px;color:var(--mu)}
.bars + .bl i{flex:1;text-align:center;font-style:normal}
.lessons li{margin-bottom:9px;color:#d3e0d7}
.lessons b{color:var(--gold2)}
table{border-collapse:collapse;width:100%;font-size:14px}
th,td{border:1px solid rgba(10,38,34,.3);padding:8px 10px;text-align:left;vertical-align:top}
th{background:var(--fg);color:var(--paper);font-weight:600}
td.g{background:#cfe8d6}td.r{background:#f2cfc7}td.y{background:#f2e6b8}

dialog{border:0;background:var(--paper);color:var(--fg);max-width:760px;width:calc(100% - 28px);border-radius:3px;padding:24px 26px;outline:2px solid var(--fg);outline-offset:-8px;max-height:90vh;overflow:auto}
dialog::backdrop{background:rgba(2,10,9,.8)}
dialog h2{font-size:28px;margin-bottom:8px}
dialog p,dialog li{font-size:14.5px}
dialog .go{margin:14px 0 0;background:var(--fg);color:var(--paper)}
.toast{position:fixed;left:50%;bottom:26px;transform:translateX(-50%);background:var(--gold);color:var(--ink);padding:9px 16px;border-radius:4px;font-weight:600;z-index:80;font-size:14px}

@media (max-width:1020px){
  .grid{grid-template-columns:1fr}
  .modes,.howto{grid-template-columns:1fr}
  .endgrid{grid-template-columns:1fr}
}
@media (max-width:640px){
  .charts{grid-template-columns:1fr}
  .wrap{padding:0 14px}
}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
@media print{body{background:#fff;color:#000}#bg,.ticker,.brandbar,#home,#game,#overlay,.noprint{display:none!important}.card{background:#fff;border:1px solid #444}.endh *,.card *{color:#000!important}}
</style>
</head>
<body>
<div id="bg"></div>
<div class="wrap">
  <div class="brandbar">
    <div class="seal">M</div>
    <div><b>The Governor's Desk</b><br><span>A Mundell-Fleming simulator</span></div>
    <div class="sp"></div>
    <button class="ghost" id="bPlay1">Playbook</button>
  </div>
</div>
<div class="ticker"><div class="tk" id="tk"></div></div>

<div class="wrap">

<!-- HOME -->
<section id="home" class="screen">
  <div class="hero">
    <div class="serial">Central Bank of Meridia &nbsp;|&nbsp; Series 2026 &nbsp;|&nbsp; No. MF-0001</div>
    <h1>Run the economy.<br>Bend the curves.</h1>
    <p class="lead">You are the new Governor of Meridia, a small open economy where money moves freely across borders. For eight quarters the world will throw shocks at you. Every policy you pull shifts the IS*, LM* and BP curves in front of you, and it behaves very differently depending on whether your currency is floating or pegged.</p>
    <div class="namebox"><label for="gname">Governor's name</label><input id="gname" maxlength="28" placeholder="Type your name" autocomplete="off"></div>
  </div>

  <div class="modes">
    <button class="mode" data-mode="campaign" data-reg="float">
      <h3>Campaign: floating rate</h3>
      <p>Let the market set the price of your currency. Steer output with monetary policy and watch the exchange rate absorb everything else.</p>
      <span class="tag">8 quarters, scored</span>
    </button>
    <button class="mode fx" data-mode="campaign" data-reg="fixed">
      <h3>Campaign: fixed peg</h3>
      <p>Defend the exchange rate at any cost. Fiscal policy gets teeth, monetary policy gets chained, and reserves are your lifeline.</p>
      <span class="tag">8 quarters, scored</span>
    </button>
    <button class="mode sb" data-mode="sandbox" data-reg="float">
      <h3>Sandbox lab</h3>
      <p>No score, no limits. Flip the regime, inject any shock, pull any lever and watch exactly how each curve moves.</p>
      <span class="tag">Best place to learn first</span>
    </button>
  </div>

  <div class="howto">
    <div><b>Read the shock</b>The headline tells you what moved. The advisor explains which curve shifted and why.</div>
    <div><b>Spend political capital</b>You get 3 points each quarter. Trade policy and peg changes cost 2.</div>
    <div><b>Preview before you commit</b>Dashed lines show last quarter. Solid lines show where policy takes you now.</div>
    <div><b>End the quarter</b>Points reward output near Y* = 100 and a healthy external position. Shocks fade 30% a quarter, but your policies stay.</div>
  </div>

  <div class="tri">
    <svg width="150" height="130" viewBox="0 0 150 130" aria-label="Impossible trinity triangle">
      <polygon points="75,10 12,118 138,118" fill="none" stroke="#d9b45a" stroke-width="2"/>
      <circle cx="75" cy="10" r="6" fill="#d9b45a"/><circle cx="12" cy="118" r="6" fill="#d9b45a"/><circle cx="138" cy="118" r="6" fill="#d9b45a"/>
    </svg>
    <p><b>The impossible trinity.</b> A country can have only two of three: free capital flows, a fixed exchange rate, and an independent monetary policy. The game is built on this. Free capital flows are always on here, so your real choice is which of the other two you keep.</p>
  </div>
</section>

<!-- GAME -->
<section id="game" class="screen" hidden>
  <div class="topbar">
    <div class="pill" id="qLabel">Quarter 1 of 8</div>
    <div class="pill reg" id="regBadge">Floating exchange rate</div>
    <div class="pill" id="scoreP" style="display:none">Score <b id="scoreV">0</b></div>
    <div class="pill" id="apprP" style="display:none">Approval <b id="apprV">-</b></div>
    <div class="sand" id="sand" hidden>
      <div class="seg" id="regSeg"><button data-r="float" class="on">Floating</button><button data-r="fixed">Fixed</button></div>
      <select id="shSel" aria-label="Choose a shock"></select>
      <button class="ghost" id="shGo">Hit the economy</button>
      <button class="ghost" id="rsGo">Reset</button>
    </div>
    <div class="sp"></div>
    <button class="ghost" id="bPlay2">Playbook</button>
    <button class="ghost" id="bMenu">Main menu</button>
  </div>

  <div class="grid">
    <div>
      <div class="news" id="news"></div>
      <div class="charts">
        <div class="cc">
          <h3>Output and exchange rate</h3><small>The Mankiw view: Y on the x-axis, e on the y-axis</small>
          <canvas id="cvA"></canvas>
          <div class="leg"><span><i style="background:var(--is)"></i>IS*</span><span><i style="background:var(--lm)"></i>LM*</span><span id="legPeg"><i style="background:var(--pg)"></i>Peg</span><span><i class="gh"></i>last quarter</span></div>
        </div>
        <div class="cc">
          <h3>Output and interest rate</h3><small>The IS-LM-BP view: BP is flat because capital is mobile</small>
          <canvas id="cvB"></canvas>
          <div class="leg"><span><i style="background:var(--is)"></i>IS</span><span><i style="background:var(--lm)"></i>LM</span><span><i style="background:var(--bp)"></i>BP</span><span><i class="gh"></i>last quarter</span></div>
        </div>
      </div>
    </div>
    <aside>
      <div class="card" id="dash"></div>
      <div class="card" id="levers"></div>
      <div class="card"><h3>Economist's note</h3><div class="adv" id="adv"></div></div>
      <div class="actions noprint" id="actions">
        <div class="pcs" id="pcs"></div>
        <button class="go sec" id="bUndo">Undo last move</button>
        <button class="go" id="bEnd">End quarter</button>
      </div>
    </aside>
  </div>
</section>

<!-- END -->
<section id="end" class="screen" hidden>
  <div class="endh">
    <div class="serial" id="endSerial"></div>
    <div class="rank" id="endRank"></div>
    <p class="lead" id="endLead"></p>
  </div>
  <div class="endgrid">
    <div class="card"><h3>Your quarter-by-quarter record <em>points out of 100</em></h3><div class="bars" id="bars"></div><div class="bl" id="barl"></div><div id="cmp"></div></div>
    <div class="card"><h3>What the model taught you</h3><ul class="lessons" id="lessons"></ul></div>
  </div>
  <div class="actions noprint" style="padding-bottom:60px">
    <button class="go sec" id="eAgain">Play again, new shocks</button>
    <button class="go sec" id="eOther">Same shocks, other regime</button>
    <button class="go sec" id="ePrint">Print report</button>
    <button class="go" id="eMenu">Main menu</button>
  </div>
</section>
</div>

<div id="overlay" hidden></div>

<dialog id="playbook">
  <h2>The Mundell-Fleming playbook</h2>
  <p>Small open economy, perfect capital mobility, so the domestic interest rate is pinned to the world rate r*. Price level is fixed. e is the real exchange rate: higher means a stronger currency.</p>
  <table>
    <tr><th>Policy</th><th>Floating rate</th><th>Fixed rate</th></tr>
    <tr><td>Fiscal expansion (more spending or lower taxes)</td><td class="r">Output unchanged. IS* shifts right, currency appreciates, net exports fall (full crowding out).</td><td class="g">Output rises by the full multiplier. Central bank accommodates, reserves rise.</td></tr>
    <tr><td>Monetary expansion</td><td class="g">Output rises. LM* shifts right, currency depreciates, net exports rise.</td><td class="r">Nothing. Capital flees, the central bank sells reserves, and M snaps back.</td></tr>
    <tr><td>Tariffs or import quotas</td><td class="r">Output unchanged. Currency appreciates and cancels the effect.</td><td class="g">Output rises. IS* shifts right and nothing offsets it.</td></tr>
    <tr><td>Devaluation (lower peg)</td><td class="y">Not available. The rate floats.</td><td class="g">Output rises. Exports gain, reserves build up.</td></tr>
    <tr><td>World interest rate r* rises</td><td class="y">IS* left, LM* right. Output rises, currency depreciates sharply.</td><td class="y">IS* left. Output falls and reserves drain.</td></tr>
    <tr><td>Money demand rises</td><td class="y">LM* shifts left. Output falls, currency appreciates.</td><td class="y">Capital flows in. Reserves rise, output unchanged.</td></tr>
  </table>
  <p><b>Reading the graphs.</b> In the first chart, IS* slopes down and LM* is vertical under floating rates. Under a peg, the horizontal peg line fixes e and LM* slides until it crosses IS* at the peg. In the second chart, BP is flat at r*, so the economy always settles where IS and LM both cross BP. Under floating rates, IS shifts (through e) to meet LM. Under a peg, LM shifts (through reserves) to meet IS.</p>
  <p><b>Tinbergen's rule.</b> You have two goals (output and the external position), so you need two working tools. Under floating rates, money steers output while fiscal and trade policy steer e. Under a peg, fiscal, trade and the peg level steer output while domestic credit steers reserves.</p>
  <button class="go" id="pbClose">Back to the game</button>
</dialog>

<script>
"use strict";
/* ---------- helpers ---------- */
const $=s=>document.querySelector(s);
const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
const f1=n=>(Math.round(n*10)/10).toFixed(1);
const sgn=n=>{const r=Math.round(n*10)/10;return (r<0?'\u2212':'+')+Math.abs(r).toFixed(1)};
function mulberry(a){return function(){a|=0;a=a+0x6D2B79F5|0;let t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296}}
function toast(msg){const t=document.createElement('div');t.className='toast';t.textContent=msg;document.body.appendChild(t);setTimeout(()=>t.remove(),1800)}

/* ---------- the model ---------- */
/* Y = C(Y-T) + I(r*) + G + NX(e), c1=.5, I falls 4 per point of r, NX falls .5 per unit of e
   LM*: M = Y - 8 r* + L.   Baseline: Y=100, e=100, r*=5, M=60 (D=30, R=30). */
const BASE={G:20,T:20,D:30,NXp:0,conf:0,NXs:0,L:0,rdev:0,ebar:100,regime:'float'};
function model(s){
  const rstar=5+s.rdev;
  const K=90+s.G-0.5*s.T+s.NXp+s.conf+s.NXs;
  const A=K-4*(rstar-5);
  let Y,e,M,R;
  if(s.regime==='float'){M=s.D+30;R=30;Y=M+8*rstar-s.L;e=2*A-Y}
  else{e=s.ebar;Y=2*A-e;M=Y-8*rstar+s.L;R=M-s.D}
  return{rstar,K,A,Y,e,M,R,Ylm:Y,ebar:s.ebar,L:s.L,regime:s.regime};
}
function scoreOf(m,crisis){
  const out=Math.max(0,Math.round(70-4*Math.abs(m.Y-100)));
  let ext;
  if(m.regime==='float')ext=Math.max(0,Math.round(30-1.0*Math.abs(m.e-100)));
  else ext=crisis?0:Math.round(clamp(m.R*1.5,0,30));
  return{out,ext,total:Math.max(0,out+ext-(crisis?15:0))};
}

/* ---------- content ---------- */
const SHOCKS=[
 {tag:'World rates up',head:'The Fed signals higher rates for longer',text:'Global investors chase better yields abroad. The world interest rate r* jumps.',fx:{rdev:1.2}},
 {tag:'World rates down',head:'Global central banks pivot to easing',text:'Cheap money floods the world. The world interest rate r* falls.',fx:{rdev:-1.2}},
 {tag:'Export boom',head:'Trading partners splurge on Meridian goods',text:'Foreign demand surges. Net exports jump at every exchange rate.',fx:{NXs:10}},
 {tag:'Partner slowdown',head:'Biggest trading partner slips into recession',text:'Export orders are cancelled across the country.',fx:{NXs:-10}},
 {tag:'Oil shock',head:'Oil prices spike 40% overnight',text:'The import bill balloons and drags net exports down.',fx:{NXs:-8}},
 {tag:'Confidence crash',head:'Consumer confidence collapses',text:'Households hoard cash and firms shelve investment plans.',fx:{conf:-10}},
 {tag:'Remittance boom',head:'Remittances hit an all-time record',text:'Families abroad send more money home and household spending climbs.',fx:{conf:8}},
 {tag:'Investment wave',head:'Foreign firms announce giant factory projects',text:'Business investment and construction spending surge.',fx:{conf:10}},
 {tag:'Money demand up',head:'Mobile wallets explode in popularity',text:'People want to hold more money at every level of income.',fx:{L:8}},
 {tag:'Money demand down',head:'Digital payments cut the need for cash',text:'People hold less money at every level of income.',fx:{L:-8}},
 {tag:'Disaster',head:'Devastating floods hit the heartland',text:'Crops, roads and exports take a hit and spending falls.',fx:{conf:-6,NXs:-6}},
 {tag:'Risk panic',head:'Rating agency downgrades Meridia',text:'Investors demand a risk premium. The world rate r* faced by Meridia rises and confidence slips.',fx:{rdev:1,conf:-4}}
];
function shockExplain(fx,reg){
  const o=[];
  if(fx.conf||fx.NXs){const up=((fx.conf||0)+(fx.NXs||0))>0;
    o.push(reg==='float'
     ?`IS* shifts ${up?'right':'left'}. The floating currency absorbs it: e ${up?'appreciates':'depreciates'} while output stays where the vertical LM* line holds it.`
     :`IS* shifts ${up?'right':'left'}. To hold the peg the central bank ${up?'accumulates':'burns'} reserves, LM* follows, and output ${up?'rises':'falls'}.`)}
  if(fx.rdev){const up=fx.rdev>0;
    o.push(reg==='float'
     ?`${up?'A higher':'A lower'} r* shifts IS* ${up?'left':'right'} and LM* ${up?'right':'left'}. Output ${up?'rises':'falls'} and the currency ${up?'depreciates sharply':'appreciates sharply'}.`
     :`${up?'A higher':'A lower'} r* shifts IS* ${up?'left':'right'}. Output ${up?'falls':'rises'} and capital ${up?'leaves, draining':'floods in, filling'} reserves.`)}
  if(fx.L){const up=fx.L>0;
    o.push(reg==='float'
     ?`LM* shifts ${up?'left':'right'}. Output ${up?'falls':'rises'} and the currency ${up?'appreciates':'depreciates'}.`
     :`Capital ${up?'flows in':'flows out'}, so reserves ${up?'rise':'fall'}. Output does not change because the peg fixes e.`)}
  return o.join(' ');
}
const LEVERS={
 G:{name:'Government spending',icon:'\u{1F3D7}\uFE0F',cost:1,plus:'Spend more',minus:'Cut spending',apply:(s,d)=>{s.G=clamp(s.G+6*d,0,60)},exp:d=>d>0,val:s=>s.G},
 T:{name:'Taxes',icon:'\u{1F9FE}',cost:1,plus:'Raise taxes',minus:'Cut taxes',apply:(s,d)=>{s.T=clamp(s.T+10*d,0,60)},exp:d=>d<0,val:s=>s.T},
 D:{name:'Money supply (open-market operations)',icon:'\u{1F3E6}',cost:1,plus:'Buy bonds',minus:'Sell bonds',apply:(s,d)=>{s.D=Math.max(0,s.D+8*d)},exp:d=>d>0,val:s=>s.D},
 N:{name:'Trade policy',icon:'\u{1F6A2}',cost:2,plus:'Add tariffs',minus:'Liberalise',apply:(s,d)=>{s.NXp=clamp(s.NXp+8*d,-24,24)},exp:d=>d>0,val:s=>s.NXp},
 P:{name:'Exchange rate peg',icon:'\u{1F4CC}',cost:2,fixedOnly:true,plus:'Revalue',minus:'Devalue',apply:(s,d)=>{s.ebar=clamp(s.ebar+10*d,50,150)},exp:d=>d<0,val:s=>s.ebar}
};
function explainMove(id,d,reg){
  const ex=LEVERS[id].exp(d), t=(a,b)=>ex?a:b;
  if(id==='G'||id==='T'){
    return reg==='float'
     ?`${t('Fiscal expansion','Fiscal contraction')} shifts <b>IS*</b> ${t('right','left')}. Interest rates are pinned at r*, so capital flows ${t('in','out')} and the currency ${t('appreciates','depreciates')}. Net exports ${t('fall','rise')} by exactly what the government ${t('added','removed')}, so <b>output does not change</b>. Only e moves. Fiscal policy is powerless under floating rates.`
     :`${t('Fiscal expansion','Fiscal contraction')} shifts <b>IS*</b> ${t('right','left')} and pushes e ${t('up','down')}. To defend the peg the central bank ${t('sells','buys')} domestic currency, so the money supply ${t('rises','falls')} and <b>LM* follows IS*</b>. Output moves by the full multiplier and reserves ${t('rise','fall')}. Fiscal policy is powerful under a peg.`;
  }
  if(id==='D'){
    return reg==='float'
     ?`${t('Monetary expansion','Monetary tightening')} shifts <b>LM*</b> ${t('right','left')}. Domestic rates ${t('dip below','rise above')} r*, capital ${t('leaves','enters')} and the currency ${t('depreciates','appreciates')}. The ${t('weaker','stronger')} currency ${t('lifts','cuts')} net exports, so <b>output ${t('rises','falls')}</b>. Monetary policy is powerful under floating rates.`
     :`You try to ${t('expand','tighten')} the money supply, but that would push rates ${t('below','above')} r* and trigger capital ${t('flight','inflow')}. To defend the peg the central bank must reverse it: M snaps back, domestic credit D ${t('rises','falls')} while reserves R ${t('fall','rise')}. <b>Output is unchanged.</b> Monetary policy is impotent under a peg.`;
  }
  if(id==='N'){
    return reg==='float'
     ?`${t('Tariffs','Liberalisation')} lift net exports at any exchange rate, so <b>IS*</b> shifts ${t('right','left')}. But the currency ${t('appreciates','depreciates')} by just enough to cancel it. <b>Output does not change</b>, and total trade does not change either. Only e moves.`
     :`${t('Tariffs','Liberalisation')} shift <b>IS*</b> ${t('right','left')}. With e pinned nothing offsets it, so the central bank accommodates and <b>output ${t('rises','falls')}</b>. Reserves ${t('build up','drain')}.`;
  }
  const up=d>0;
  return `${up?'Revaluing':'Devaluing'} the peg moves e ${up?'up':'down'}. Net exports ${up?'fall':'rise'}, <b>IS*</b> shifts ${up?'left':'right'}, and the central bank accommodates. <b>Output ${up?'falls':'rises'}</b> and reserves ${up?'drain':'build up'}.`;
}

/* ---------- game state ---------- */
let S={mode:null,q:0,cur:null,base:null,hist:[],pc:3,score:0,shocks:[],seed:0,ghost:null,last:null,shock:null,qs:[],crises:0,name:'Governor',reg:'float'};
const RESULTS={};
const TOTALQ=8;
const FIELDS=['A','Ylm','ebar','K','e','M','L','rstar','Y'];
let TG={},V={},running=false;

function pickShocks(seed){const r=mulberry(seed),a=SHOCKS.slice();for(let i=a.length-1;i>0;i--){const j=Math.floor(r()*(i+1));[a[i],a[j]]=[a[j],a[i]]}return a.slice(0,TOTALQ)}
function show(id){['home','game','end'].forEach(x=>$('#'+x).hidden=(x!==id));running=(id==='game');window.scrollTo(0,0);if(running)requestAnimationFrame(frame)}
function setTicker(items){const h=items.map(x=>`<span>${x}</span><i>|</i>`).join('');$('#tk').innerHTML=h+h}
function defaultTicker(){setTicker(['Meridia calls on its new Governor','Eight quarters. Twelve possible shocks. One currency to protect','Free capital flows are switched on','Fiscal policy: strong under a peg, weak under a float','Monetary policy: strong under a float, impotent under a peg','Policy has side effects. Check the exchange rate and reserves'])}

function startGame(mode,reg,seed){
  S.name=($('#gname').value||'').trim()||'Governor';
  S.mode=mode;S.reg=reg;S.q=0;S.score=0;S.qs=[];S.crises=0;S.hist=[];S.last=null;S.shock=null;
  S.seed=seed||Math.floor(Math.random()*1e6)+1;
  S.cur={...BASE,regime:reg};S.base={...S.cur};S.ghost=model(S.cur);S.pc=mode==='sandbox'?99:3;
  const m=model(S.cur);FIELDS.forEach(k=>{V[k]=m[k]});
  buildLevers();
  const sb=mode==='sandbox';
  $('#sand').hidden=!sb;$('#scoreP').style.display=sb?'none':'';$('#apprP').style.display=sb?'none':'';
  $('#bEnd').style.display=sb?'none':'';$('#pcs').style.display=sb?'none':'';
  $('#bUndo').textContent=sb?'Undo':'Undo last move';
  if(sb){
    S.shocks=[];
    $('#shSel').innerHTML=SHOCKS.map((x,i)=>`<option value="${i}">${x.head}</option>`).join('');
    syncSeg();
    $('#qLabel').textContent='Sandbox lab';
    $('#news').innerHTML=`<div class="t">Sandbox lab</div><h2>No score. No limits.</h2><p>Pull any lever, switch the regime, or hit the economy with a shock. Dashed lines always show where the curves were before your last action.</p>`;
    show('game');refresh();setTicker(['Sandbox: experiment freely','Try fiscal expansion under both regimes','Try monetary expansion under both regimes','Then inject a world interest rate shock']);
  }else{
    S.shocks=pickShocks(S.seed);show('game');nextQuarter();
  }
}
function decay(){['conf','NXs','L','rdev'].forEach(k=>{S.cur[k]=Math.abs(S.cur[k]*0.7)<0.05?0:Math.round(S.cur[k]*0.7*100)/100})}
function nextQuarter(){
  S.q++;
  if(S.q>TOTALQ)return finish();
  if(S.q>1)decay();
  const sh=S.shocks[S.q-1];S.shock=sh;
  for(const k in sh.fx)S.cur[k]=Math.round((S.cur[k]+sh.fx[k])*100)/100;
  S.base={...S.cur};S.hist=[];S.pc=3;S.last=null;
  $('#qLabel').textContent=`Quarter ${S.q} of ${TOTALQ}`;
  const n=$('#news');n.innerHTML=`<div class="t">${sh.tag}</div><h2>${sh.head}</h2><p>${sh.text}</p><div class="fxn">${shockExplain(sh.fx,S.cur.regime)}</div>`;
  n.classList.remove('hit');void n.offsetWidth;n.classList.add('hit');
  const m=model(S.cur);
  setTicker([`Q${S.q}: ${sh.head}`,`Output index ${f1(m.Y)} (target 100)`,S.cur.regime==='float'?`Exchange rate e ${f1(m.e)}`:`Peg held at ${f1(S.cur.ebar)}, reserves ${f1(m.R)}`,`World interest rate ${f1(m.rstar)}%`,`Governor ${S.name} is under pressure`]);
  refresh();
}

/* ---------- moves ---------- */
function doMove(id,d){
  const L=LEVERS[id],sb=S.mode==='sandbox';
  if(L.fixedOnly&&S.cur.regime!=='fixed')return;
  if(!sb&&S.pc<L.cost)return toast('Not enough political capital');
  const before=model(S.cur),ns={...S.cur};L.apply(ns,d);
  if(JSON.stringify(ns)===JSON.stringify(S.cur))return toast('That lever is at its limit');
  S.hist.push({s:S.cur,pc:S.pc});S.cur=ns;if(!sb)S.pc-=L.cost;
  S.last={id,d,before,after:model(ns),reg:ns.regime};
  if(sb)S.ghost=before;
  refresh();
}
function undo(){
  if(!S.hist.length)return;const h=S.hist.pop();S.cur=h.s;S.pc=h.pc;S.last=null;
  if(S.mode==='sandbox')S.ghost=model(S.cur);
  refresh();
}
function sandboxShock(){
  const sh=SHOCKS[+$('#shSel').value];S.ghost=model(S.cur);
  for(const k in sh.fx)S.cur[k]=Math.round((S.cur[k]+sh.fx[k])*100)/100;
  S.hist.push({s:{...S.cur},pc:99});S.hist.pop();
  S.last=null;S.shock=sh;
  const n=$('#news');n.innerHTML=`<div class="t">${sh.tag}</div><h2>${sh.head}</h2><p>${sh.text}</p><div class="fxn">${shockExplain(sh.fx,S.cur.regime)}</div>`;
  n.classList.remove('hit');void n.offsetWidth;n.classList.add('hit');
  refresh();
}
function setRegime(r){
  if(S.cur.regime===r)return;
  const m=model(S.cur);S.ghost=m;
  S.cur={...S.cur,regime:r};
  if(r==='fixed')S.cur.ebar=Math.round(m.e);
  S.cur.D=Math.max(0,m.M-30);S.hist=[];S.last=null;
  syncSeg();refresh();
}
function syncSeg(){document.querySelectorAll('#regSeg button').forEach(b=>b.classList.toggle('on',b.dataset.r===S.cur.regime))}
function resetSandbox(){S.cur={...BASE,regime:S.cur.regime};if(S.cur.regime==='fixed'){S.cur.ebar=100}S.hist=[];S.last=null;S.ghost=model(S.cur);syncSeg();$('#news').innerHTML=`<div class="t">Sandbox lab</div><h2>Economy reset.</h2><p>Back to the baseline: Y = 100, e = 100, r* = 5%.</p>`;refresh()}

/* ---------- UI refresh ---------- */
function buildLevers(){
  $('#levers').innerHTML='<h3>Policy levers <em id="lvNote"></em></h3>'+Object.entries(LEVERS).map(([id,L])=>
   `<div class="lev" data-id="${id}"><div class="li">${L.icon}</div><div class="lt"><b>${L.name}</b><small class="lv"></small></div><div class="lb"><button data-d="-1">${L.minus}</button><button data-d="1">${L.plus}</button></div><span class="cost">${L.cost} PC</span></div>`).join('');
  document.querySelectorAll('#levers .lev button').forEach(b=>b.onclick=()=>doMove(b.closest('.lev').dataset.id,+b.dataset.d));
}
const gauge=(v,min,max,zl,zh,col)=>{const p=x=>clamp((x-min)/(max-min)*100,0,100);return `<div class="gauge"><i class="zone" style="left:${p(zl)}%;width:${p(zh)-p(zl)}%"></i><i class="mk" style="left:${p(v)}%;background:${col||'#fff'}"></i></div>`};
function refresh(){
  const s=S.cur,m=model(s),sb=S.mode==='sandbox',sc=scoreOf(m,false);
  TG={};FIELDS.forEach(k=>TG[k]=m[k]);
  const fixed=s.regime==='fixed';
  const rb=$('#regBadge');rb.textContent=fixed?'Fixed exchange rate':'Floating exchange rate';rb.classList.toggle('fixed',fixed);
  $('#legPeg').style.display=fixed?'':'none';
  $('#scoreV').textContent=Math.round(S.score);
  $('#apprV').textContent=S.qs.length?Math.round(S.score/(S.qs.length*100)*100)+'%':'-';
  const atk=fixed&&m.R<=0;
  let h='<h3>Economy dashboard <em>target Y* = 100</em></h3>';
  h+=`<div class="drow"><div class="dl">Output Y</div><div class="dv"><b>${f1(m.Y)}</b> (${sgn(m.Y-100)})</div>${gauge(m.Y,60,140,96,104)}</div>`;
  if(fixed){
    h+=`<div class="drow"><div class="dl">Peg level</div><div class="dv"><b>${f1(s.ebar)}</b></div></div>`;
    h+=`<div class="drow"><div class="dl">Reserves R</div><div class="dv"><b class="${m.R<8?'warn':''}">${f1(m.R)}</b>${atk?' <span class="warn">attack!</span>':''}</div>${gauge(m.R,0,50,20,50,m.R<8?'#ff6b57':'#fff')}</div>`;
  }else{
    h+=`<div class="drow"><div class="dl">Exchange rate e</div><div class="dv"><b>${f1(m.e)}</b> (${sgn(m.e-100)})</div>${gauge(m.e,40,160,90,110)}</div>`;
  }
  h+=`<div class="drow"><div class="dl">World rate r*</div><div class="dv"><b>${f1(m.rstar)}%</b></div></div>`;
  h+=`<div class="drow"><div class="dl">Money supply M = D + R</div><div class="dv"><b>${f1(m.M)}</b> = ${f1(s.D)} + ${f1(m.R)}</div></div>`;
  h+=`<div class="drow"><div class="dl">Budget stance (G minus T)</div><div class="dv"><b>${sgn(s.G-s.T)}</b></div></div>`;
  if(!sb)h+=`<div class="proj"><span>Projected points this quarter<br><small style="color:var(--mu)">output ${sc.out}/70, ${fixed?'reserves':'exchange rate'} ${sc.ext}/30</small></span><b>${atk?'Crisis':sc.total}</b></div>`;
  $('#dash').innerHTML=h;
  document.querySelectorAll('#levers .lev').forEach(el=>{
    const L=LEVERS[el.dataset.id];const off=L.fixedOnly&&!fixed;
    el.classList.toggle('off',off);el.style.display='';
    el.querySelector('.lv').textContent=off?'only under a peg':'now '+f1(L.val(s));
    el.querySelectorAll('button').forEach(b=>b.disabled=off||(!sb&&S.pc<L.cost));
  });
  $('#lvNote').textContent=sb?'unlimited':'political capital: '+S.pc;
  $('#pcs').innerHTML='Political capital '+[0,1,2].map(i=>`<span class="pip ${i<S.pc?'on':''}"></span>`).join('');
  $('#bUndo').disabled=!S.hist.length;
  // advisor
  let a;
  if(S.last){
    const l=S.last,dY=l.after.Y-l.before.Y,dE=l.after.e-l.before.e,dR=l.after.R-l.before.R;
    const c=(lab,v,pos)=>`<span class="chip ${Math.abs(v)<0.05?'':(v>0===pos?'up':'dn')}">${lab} ${sgn(v)}</span>`;
    a=explainMove(l.id,l.d,l.reg)+`<div class="chips"><span class="chip">${LEVERS[l.id].name}</span>${c('Output',dY,true)}${c('e',dE,true)}${l.reg==='fixed'?c('Reserves',dR,true):''}</div>`;
  }else if(S.shock){
    a=`<b>Situation.</b> ${shockExplain(S.shock.fx,s.regime)} Now choose your response. ${sb?'':'Every lever you use spends political capital.'}`;
  }else a='Pull a lever and the curves will move. This note explains what happened and why.';
  $('#adv').innerHTML=a;
}

/* ---------- quarter end ---------- */
function showOverlay(h,cls){const o=$('#overlay');o.innerHTML=`<div class="box ${cls||''}">${h}</div>`;o.hidden=false}
function endQuarter(){
  let crisis=false,m=model(S.cur),msg='';
  if(S.cur.regime==='fixed'&&m.R<=0){
    crisis=true;S.crises++;S.cur.ebar-=15;m=model(S.cur);S.cur.D=Math.max(0,m.M-10);m=model(S.cur);
    msg='Speculators emptied your reserves and the peg broke. You were forced to devalue by 15 and take an emergency loan that restored reserves to 10.';
  }
  const sc=scoreOf(m,crisis);S.score+=sc.total;
  S.qs.push({q:S.q,...sc,Y:m.Y,e:m.e,R:m.R,crisis});
  S.ghost=model(S.cur);S.hist=[];
  const gap=m.Y-100;
  const verdict=crisis?msg:(Math.abs(gap)<=3?'Output is right on target. Excellent work.':gap>0?'The economy is overheating. Output is above its full-employment level.':'The economy is in a slump. Output is below its full-employment level.');
  const last=S.q===TOTALQ;
  showOverlay(`<h2>${crisis?'Speculative attack':'Quarter '+S.q+' results'}</h2><p>${verdict}</p>
   <div class="rg"><span>Output Y</span><span>${f1(m.Y)} (${sc.out}/70)</span>
   <span>${m.regime==='float'?'Exchange rate e':'Reserves R'}</span><span>${m.regime==='float'?f1(m.e):f1(m.R)} (${sc.ext}/30)</span>
   ${crisis?'<span>Crisis penalty</span><span>-15</span>':''}</div>
   <div class="big">+${sc.total}</div>
   <button class="go" id="nxt">${last?'See my final report':'Next quarter'}</button>`,crisis?'crisis':'');
  if(crisis)document.body.classList.add('shake'),setTimeout(()=>document.body.classList.remove('shake'),600);
  $('#nxt').onclick=()=>{$('#overlay').hidden=true;nextQuarter()};
  refresh();
}
function grade(t){return t>=700?'Central banking legend':t>=600?'Governor':t>=480?'Deputy governor':t>=340?'Trainee economist':'Dismissed by parliament'}
function finish(){
  const t=Math.round(S.score);RESULTS[S.seed+S.cur.regime]=t;
  show('end');
  $('#endSerial').textContent=`Governor ${S.name} | ${S.cur.regime==='float'?'Floating rate':'Fixed peg'} | Seed ${S.seed}`;
  $('#endRank').textContent=grade(t);
  $('#endLead').textContent=`${S.name}, you finished with ${t} out of ${TOTALQ*100} points (approval ${Math.round(t/(TOTALQ*100)*100)}%)${S.crises?` and survived ${S.crises} speculative attack${S.crises>1?'s':''}`:''}.`;
  $('#bars').innerHTML=S.qs.map(x=>`<div class="${x.crisis?'cr':''}" style="height:${Math.max(3,x.total)}%"><span>${x.total}</span></div>`).join('');
  $('#barl').innerHTML=S.qs.map(x=>`<i>Q${x.q}</i>`).join('');
  const other=S.cur.regime==='float'?'fixed':'float';
  const o=RESULTS[S.seed+other];
  $('#cmp').innerHTML=o!=null?`<p style="margin:18px 0 0;border-top:1px dashed var(--ln);padding-top:12px">Same shocks, two regimes: floating scored <b style="color:var(--gold2)">${RESULTS[S.seed+'float']??'-'}</b> and fixed scored <b style="color:var(--gold2)">${RESULTS[S.seed+'fixed']??'-'}</b>.</p>`:'';
  const L=[];
  if(S.cur.regime==='float'){
    L.push('<b>Monetary policy worked.</b> Under floating rates, open-market operations moved LM* and steered output.');
    L.push('<b>Fiscal and trade policy only moved e.</b> Spending, taxes and tariffs shifted IS*, but the exchange rate moved to cancel the effect on output.');
    L.push('<b>The exchange rate is the shock absorber.</b> Demand-side shocks hit e, not output.');
  }else{
    L.push('<b>Fiscal policy had teeth.</b> With e pinned, IS* shifts changed output by the full multiplier.');
    L.push('<b>Monetary policy was chained.</b> Open-market operations only swapped domestic credit for reserves and left output untouched.');
    L.push('<b>Reserves were the shock absorber.</b> Shocks drained or filled them, and running out meant a speculative attack.');
  }
  L.push('<b>The trilemma.</b> With free capital flows, you give up either control of monetary policy (peg) or control of the exchange rate (float).');
  L.push('<b>Two goals need two tools.</b> Output and the external position each need their own working lever. That is Tinbergen\'s rule.');
  $('#lessons').innerHTML=L.map(x=>`<li>${x}</li>`).join('');
  defaultTicker();
}

/* ---------- drawing ---------- */
function setup(cv){const r=cv.getBoundingClientRect(),dpr=window.devicePixelRatio||1,w=Math.max(180,Math.round(r.width)),h=Math.max(180,Math.round(r.height));
  if(cv.width!==Math.round(w*dpr)||cv.height!==Math.round(h*dpr)){cv.width=Math.round(w*dpr);cv.height=Math.round(h*dpr)}
  const ctx=cv.getContext('2d');ctx.setTransform(dpr,0,0,dpr,0,0);return{ctx,W:w,H:h}}
const FF='"IBM Plex Sans",system-ui,sans-serif';
function chart(cv,sp){
  const{ctx,W,H}=setup(cv);ctx.clearRect(0,0,W,H);
  const pl={l:42,r:W-12,t:12,b:H-34},[x0,x1]=sp.xr,[y0,y1]=sp.yr;
  const X=v=>pl.l+(v-x0)/(x1-x0)*(pl.r-pl.l),Y=v=>pl.b-(v-y0)/(y1-y0)*(pl.b-pl.t);
  ctx.font=`11px ${FF}`;ctx.lineWidth=1;ctx.strokeStyle='rgba(10,38,34,.13)';ctx.fillStyle='#3f5a50';
  ctx.textAlign='center';
  for(let v=x0;v<=x1;v+=sp.xt){ctx.beginPath();ctx.moveTo(X(v),pl.t);ctx.lineTo(X(v),pl.b);ctx.stroke();ctx.fillText(v,X(v),pl.b+14)}
  ctx.textAlign='right';
  for(let v=y0;v<=y1+1e-6;v+=sp.yt){ctx.beginPath();ctx.moveTo(pl.l,Y(v));ctx.lineTo(pl.r,Y(v));ctx.stroke();ctx.fillText(v,pl.l-6,Y(v)+4)}
  ctx.strokeStyle='#0a2622';ctx.lineWidth=1.5;ctx.beginPath();ctx.moveTo(pl.l,pl.t);ctx.lineTo(pl.l,pl.b);ctx.lineTo(pl.r,pl.b);ctx.stroke();
  ctx.textAlign='center';ctx.fillStyle='#0a2622';ctx.font=`600 12px ${FF}`;ctx.fillText(sp.xl,(pl.l+pl.r)/2,H-5);
  ctx.save();ctx.translate(11,(pl.t+pl.b)/2);ctx.rotate(-Math.PI/2);ctx.fillText(sp.yl,0,0);ctx.restore();
  ctx.save();ctx.beginPath();ctx.rect(pl.l,pl.t,pl.r-pl.l,pl.b-pl.t);ctx.clip();
  // full-employment line
  ctx.setLineDash([3,4]);ctx.strokeStyle='#1b7a4b';ctx.lineWidth=1.5;ctx.beginPath();ctx.moveTo(X(100),pl.t);ctx.lineTo(X(100),pl.b);ctx.stroke();ctx.setLineDash([]);
  const line=(c,al,dash,w)=>{ctx.globalAlpha=al;ctx.strokeStyle=c.color;ctx.lineWidth=w;ctx.setLineDash(dash);ctx.beginPath();ctx.moveTo(X(c.a[0]),Y(c.a[1]));ctx.lineTo(X(c.b[0]),Y(c.b[1]));ctx.stroke();ctx.setLineDash([]);ctx.globalAlpha=1};
  sp.ghosts.forEach(c=>line(c,.55,[6,5],1.6));
  sp.curves.forEach(c=>line(c,1,[],3));
  ctx.restore();
  ctx.font=`600 12px ${FF}`;
  ctx.fillStyle='#1b7a4b';ctx.textAlign='left';ctx.fillText('Y*',X(100)+4,pl.t+11);
  sp.curves.forEach(c=>{const lx=clamp(c.lx,x0+2,x1-2),ly=clamp(c.ly,y0+(y1-y0)*.05,y1-(y1-y0)*.07);ctx.fillStyle=c.color;ctx.textAlign=c.al||'left';ctx.fillText(c.label,X(lx),Y(ly)-6)});
  // equilibrium
  const[dx,dy]=sp.dot,px=X(dx),py=Y(dy),t=performance.now()/450;
  ctx.fillStyle='rgba(10,38,34,.16)';ctx.beginPath();ctx.arc(px,py,9+3*Math.sin(t),0,7);ctx.fill();
  ctx.fillStyle='#0a2622';ctx.beginPath();ctx.arc(px,py,5.2,0,7);ctx.fill();ctx.strokeStyle='#e3eae1';ctx.lineWidth=1.5;ctx.stroke();
  const tx=`Y ${f1(dx)}, ${sp.dl} ${f1(dy)}`;ctx.font=`600 11.5px ${FF}`;const tw=ctx.measureText(tx).width;
  let bx=px+12;if(bx+tw+10>pl.r)bx=px-12-tw-10;let by=py-26;if(by<pl.t)by=py+10;
  ctx.fillStyle='#0a2622';ctx.fillRect(bx,by,tw+10,18);ctx.fillStyle='#f0d78f';ctx.textAlign='left';ctx.fillText(tx,bx+5,by+13);
}
function curvesA(o,fixed){
  const c=[{a:[60,2*o.A-60],b:[140,2*o.A-140],color:'#c8321f',label:'IS*',lx:63,ly:2*o.A-63},
           {a:[o.Ylm,40],b:[o.Ylm,160],color:'#1747b5',label:'LM*',lx:o.Ylm+1,ly:150}];
  if(fixed)c.push({a:[60,o.ebar],b:[140,o.ebar],color:'#6b3fb0',label:'Peg',lx:138,ly:o.ebar,al:'right'});
  return c;
}
function curvesB(o){
  const isR=Y=>5+(o.K-0.5*o.e-0.5*Y)/4,lmR=Y=>(Y+o.L-o.M)/8;
  return[{a:[60,isR(60)],b:[140,isR(140)],color:'#c8321f',label:'IS',lx:63,ly:isR(63)},
         {a:[60,lmR(60)],b:[140,lmR(140)],color:'#1747b5',label:'LM',lx:128,ly:lmR(128),al:'right'},
         {a:[60,o.rstar],b:[140,o.rstar],color:'#9a6b00',label:'BP',lx:138,ly:o.rstar,al:'right'}];
}
function frame(){
  if(!running)return;
  for(const k of FIELDS)if(TG[k]!=null)V[k]+=(TG[k]-V[k])*0.16;
  const fixed=S.cur.regime==='fixed',g=S.ghost;
  chart($('#cvA'),{xr:[60,140],yr:[40,160],xt:20,yt:20,xl:'Output Y',yl:'Exchange rate e',dl:'e',
    curves:curvesA(V,fixed),ghosts:curvesA(g,g.regime==='fixed'),dot:[V.Y,V.e]});
  chart($('#cvB'),{xr:[60,140],yr:[0,12],xt:20,yt:2,xl:'Output Y',yl:'Interest rate r (%)',dl:'r',
    curves:curvesB(V),ghosts:curvesB(g),dot:[V.Y,V.rstar]});
  requestAnimationFrame(frame);
}

/* ---------- wiring ---------- */
document.querySelectorAll('.mode').forEach(b=>b.onclick=()=>startGame(b.dataset.mode,b.dataset.reg));
$('#bUndo').onclick=undo;$('#bEnd').onclick=endQuarter;
$('#shGo').onclick=sandboxShock;$('#rsGo').onclick=resetSandbox;
document.querySelectorAll('#regSeg button').forEach(b=>b.onclick=()=>setRegime(b.dataset.r));
$('#bMenu').onclick=()=>{$('#overlay').hidden=true;show('home');defaultTicker()};
$('#eMenu').onclick=()=>{show('home');defaultTicker()};
$('#eAgain').onclick=()=>startGame('campaign',S.cur.regime);
$('#eOther').onclick=()=>startGame('campaign',S.cur.regime==='float'?'fixed':'float',S.seed);
$('#ePrint').onclick=()=>window.print();
const pb=$('#playbook');
['bPlay1','bPlay2'].forEach(id=>$('#'+id).onclick=()=>pb.showModal());
$('#pbClose').onclick=()=>pb.close();
defaultTicker();
</script>
